# URL HTTPS công khai của ERP, dùng cho approval link, callback/OAuth và các link pháp lý trên web.
APP_URL=
# Tùy chọn: URL công khai riêng cho frontend. Để trống sẽ dùng APP_URL;
# khi cả hai để trống, các link trên frontend dùng địa chỉ web đang mở.
# Đây là URL công khai, được nhúng vào frontend khi chạy dev/build; không đặt thông tin bí mật.
VITE_APP_URL=

# SePay retail-order webhook authentication. Prefer HMAC-SHA256 in production.
# Configure SePay webhook URL: POST /api/v1/webhook/sepay/retail-payment
SEPAY_WEBHOOK_SECRET=
# Optional API Key fallback for legacy SePay webhook configurations.
SEPAY_API_KEY=

# Super Admin Account Seed configuration credentials (chỉ dùng phía server)
# Nếu để trống SUPERADMIN_PASSWORD, server sẽ bỏ qua bước seed tài khoản superadmin.
# LƯU Ý: không dùng tiền tố VITE_ cho các biến nhạy cảm — Vite sẽ đưa biến VITE_* vào bundle frontend.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=

# Cloudinary Integration Config
CLOUDINARY_CLOUD_NAME=xx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# MongoDB Integration Config
MONGODB_URI=xxx
MONGODB_USER=xxx
MONGODB_PASSWORD=xxx
MONGODB_AUTH_SOURCE=xxx

# JWT Auth Config (BẮT BUỘC — server từ chối khởi động nếu để trống)
# Sinh secret ngẫu nhiên: openssl rand -hex 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Student QR remembered-device credentials. Generate a separate random value:
# openssl rand -hex 64
STUDENT_DEVICE_TOKEN_PEPPER=
# Device recognition is renewed after each successful use; valid range is 1-365 days.
STUDENT_DEVICE_TTL_DAYS=180

# Worker QR remembered-device credentials. Generate a separate random value:
# openssl rand -hex 64
WORKER_DEVICE_TOKEN_PEPPER=
# Device recognition is renewed after each successful use; valid range is 1-365 days.
WORKER_DEVICE_TTL_DAYS=180

# Redis internal Docker network
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Multilayer DDoS protection overrides
DDOS_GLOBAL_WINDOW_MS=900000
DDOS_GLOBAL_LIMIT=1000
DDOS_PUBLIC_WINDOW_MS=900000
DDOS_PUBLIC_LIMIT=150
DDOS_EXPENSIVE_WINDOW_MS=900000
DDOS_EXPENSIVE_LIMIT=60
# Wide IP backstops for shared office NAT/CGNAT; per-account and per-user limits remain stricter.
DDOS_AUTH_IP_LIMIT=300
DDOS_LOGIN_ACCOUNT_WINDOW_MS=900000
DDOS_LOGIN_ACCOUNT_LIMIT=10
DDOS_REFRESH_IP_WINDOW_MS=900000
DDOS_REFRESH_IP_LIMIT=1000
DDOS_GENERAL_BODY_LIMIT=2mb
DDOS_LARGE_BODY_LIMIT=300mb
DDOS_SOCKET_HANDSHAKE_WINDOW_MS=60000
DDOS_SOCKET_HANDSHAKE_LIMIT=300
DDOS_SOCKET_MAX_PER_USER=5
DDOS_SOCKET_MAX_PER_IP=500
DDOS_SOCKET_EVENT_WINDOW_MS=60000
DDOS_SOCKET_EVENT_LIMIT=120
DDOS_SOCKET_VIOLATION_LIMIT=3
DDOS_REDIS_PREFIX=igen:ddos:

# Exactly 32 random bytes encoded as 64 hex characters.
SUPERADMIN_ENCRYPTION_KEY=
# Deployment-owned; accepted values are staging or production.
DEPLOYMENT_ENV=staging

# Server-only InsightFace integration (never expose through VITE_* variables)
INSIGHTFACE_URL=http://insightface:8000
INSIGHTFACE_API_KEY=replace-with-server-api-key
INSIGHTFACE_TIMEOUT_MS=10000

# ============================================================================
# MARKETING ERP — AI, Campaign, Facebook, TikTok, Zalo và tích hợp
# APP_URL, Redis, Cloudinary và Google Drive dùng cấu hình ERP ở các nhóm chung.
# Không dùng URL/queue của ứng dụng Marketing độc lập cho callback và worker ERP.
# ============================================================================

# 1. AI qua OpenRouter — chữ, phân tích và tạo ảnh trong Campaign
# Model chữ dùng GPT-6 Luna; tạo ảnh dùng model riêng qua OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL="openai/gpt-6-luna"
OPENROUTER_HEAVY_MODEL="openai/gpt-6-luna"
OPENROUTER_IMAGE_MODEL="google/gemini-3.1-flash-image"
# Fallback cho chữ; không dùng model chữ thay cho model tạo ảnh.
OPENROUTER_FALLBACK_MODEL="qwen/qwen3.6-flash"
# Model riêng cho các tác vụ nội dung và phân tích trong Campaign.
CAMPAIGN_BUDGET_MODEL="openai/gpt-6-luna"
CAMPAIGN_PREMIUM_MODEL="openai/gpt-6-luna"
CAMPAIGN_RESEARCH_MODEL="openai/gpt-6-luna"
CAMPAIGN_VISION_BUDGET_MODEL="openai/gpt-6-luna"
ASSET_ORDER_AI_MODEL="openai/gpt-6-luna"
# Để trống các model dự phòng dưới đây sẽ giữ fallback hiện có trong code.
ASSET_ORDER_AI_FALLBACK_MODEL=
BULK_CREATE_AI_MODEL="openai/gpt-6-luna"
IMAGE_PROMPT_FALLBACK_MODEL=
# Message hiện dùng policy trong shared/marketing-suite/ai-reply-models.ts:
# chính openai/gpt-6-luna; dự phòng deepseek/deepseek-v4.1-flash.
# AI_REPLY_MESSAGE_MODEL / AI_REPLY_COMMENT_MODEL trong env chưa được code đọc.
AI_REPLY_BUBBLE_DELAY_SECONDS=3
# Để trống sẽ giữ thời gian gom tin nhắn mặc định trong code.
AI_REPLY_GROUPING_DELAY_SECONDS=

# 2. Campaign và worker — tiến trình worker chạy riêng, dùng Redis ERP
# Đổi queue prefix riêng cho từng môi trường; không trùng Marketing độc lập.
MARKETING_WORKERS_ENABLED=false
MARKETING_WORKER_ROLE=all
MARKETING_QUEUE_PREFIX=igen-erp-marketing-staging
# Để trống approval secret sẽ dùng giá trị dẫn xuất từ JWT_ACCESS_SECRET.
MARKETING_APPROVAL_SECRET=
# Sinh worker secret riêng cho ERP: openssl rand -hex 32
CAMPAIGN_WORKER_SECRET=

# 3. Facebook — OAuth <APP_URL>/api/v1/facebook/oauth-callback
# Webhook <APP_URL>/api/v1/facebook/webhook
FB_APP_ID=
FB_APP_SECRET=
# Phải khớp Verify Token đã đăng ký bên Meta.
FB_VERIFY_TOKEN=
# Tùy chọn; ưu tiên cấu hình Fanpage theo doanh nghiệp trong giao diện ERP.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# 4. TikTok — đăng ký callback <APP_URL>/api/v1/tiktok/oauth/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Để trống sẽ tự lấy callback từ APP_URL ERP.
TIKTOK_REDIRECT_URI=
TIKTOK_WEBHOOK_SECRET=
# Tùy chọn nếu webhook dùng secret riêng của ứng dụng TikTok Business.
TIKTOK_BUSINESS_CLIENT_SECRET=

# 5. Zalo OA — webhook <APP_URL>/api/v1/zalo/webhook
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_ID=
# Secret xác minh chữ ký webhook; cần lấy đúng từ cấu hình ứng dụng Zalo.
ZALO_OA_SECRET_KEY=

# 6. n8n — URL và secret của workflow dành riêng cho ERP
N8N_WEBHOOK_SECRET=
N8N_FB_WEBHOOK_URL=
N8N_FB_VALIDATE_URL=
N8N_CAMPAIGN_FB_WEBHOOK_URL=

# 7. Campaign research qua Apify — chỉ bật khi đã có token và ngân sách
APIFY_RESEARCH_ENABLED=false
APIFY_TOKEN=
APIFY_BILLING_MODE=shadow
APIFY_RESEARCH_CACHE_HOURS=12
APIFY_MAX_COST_PER_SLOT_USD=0.25
APIFY_MAX_COST_PER_CAMPAIGN_USD=3.00
APIFY_GOOGLE_ACTOR_ID=apify/google-search-scraper
APIFY_GOOGLE_MAX_RESULTS=10
APIFY_FACEBOOK_ACTOR_ID=apify/facebook-posts-scraper
APIFY_FACEBOOK_MAX_RESULTS=20
APIFY_TIKTOK_ACTOR_ID=clockworks/tiktok-scraper
APIFY_TIKTOK_MAX_RESULTS=20

# 8. Google Sheets cho luồng đặt hàng Facebook có sử dụng bảng tính
# Chia sẻ bảng tính cho email service account; private key dùng chuỗi có \n.
GOOGLE_SHEETS_PROJECT_ID=
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# 9. Cấu hình đặt hàng và voice tùy chọn
SEPAY_CONFIG_ENCRYPTION_KEY=
MARKETING_BAKERY_COMPANY_CODES=
# Voice: ưu tiên thông tin nhà cung cấp theo người dùng/doanh nghiệp.
ELEVENLABS_API_KEY=
