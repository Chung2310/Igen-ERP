
# OpenRouter — nhà cung cấp chính cho text + image generation
OPENROUTER_API_KEY=sk-or-your-key-here

# Model sinh ảnh qua OpenRouter
# Gemini 3.1 Flash Image (Nano Banana 2) — dùng chat completions, hỗ trợ reference images
OPENROUTER_IMAGE_MODEL="google/gemini-3.1-flash-image"
# Hoặc dùng Gemini 3 Pro Image (Nano Banana Pro):
# OPENROUTER_IMAGE_MODEL="google/gemini-3-pro-image"

# Model text mặc định (không cần prefix — code tự thêm "google/")
GEMINI_MODEL="gemini-2.5-flash"

# Model fallback khi model text chính lỗi hết retry
OPENROUTER_FALLBACK_MODEL="qwen/qwen3.6-flash"
# Model fallback cho tạo ảnh (Qwen không có image model trên OpenRouter)
# Có thể đổi sang "openai/gpt-5.4-image-2" (khác provider) nếu tài khoản đủ credit
OPENROUTER_FALLBACK_IMAGE_MODEL="qwen/qwen3.6-flash"

# Gemini API key — chỉ cần cho video analysis (Gemini Files API)
# Để trống nếu không dùng tính năng phân tích nội dung video
GEMINI_API_KEY=your-gemini-api-key-here

# Model sinh video (dùng PIAPI)
GEMINI_VIDEO_MODEL="veo31-video-fast-audio"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Super Admin Account Seed configuration credentials (chỉ dùng phía server)
# Nếu để trống SUPERADMIN_PASSWORD, server sẽ bỏ qua bước seed tài khoản superadmin.
# LƯU Ý: không dùng tiền tố VITE_ cho các biến nhạy cảm — Vite sẽ đưa biến VITE_* vào bundle frontend.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=

# n8n Integration Config
N8N_FB_WEBHOOK_URL=xxx
N8N_FB_VALIDATE_URL=xxx
N8N_TT_VALIDATE_URL=xxx
N8N_WEBHOOK_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-domain.com/api/v1/tiktok/oauth/callback
TIKTOK_BUSINESS_REDIRECT_URI=https://your-domain.com/api/v1/tiktok-business/oauth/callback
TIKTOK_WEBHOOK_SECRET=

# Cloudinary Integration Config
CLOUDINARY_CLOUD_NAME=xx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# MongoDB Integration Config
MONGODB_URI=xxx
MONGODB_USER=xxx
MONGODB_PASSWORD=xxx
MONGODB_AUTH_SOURCE=xxx

# JWT Auth Config (BẮT BUỘC — server từ chối khởi động nếu để trống)
# Sinh secret ngẫu nhiên: openssl rand -hex 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ElevenLabs Integration Config
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# HeyGen Integration Config
HEYGEN_API_KEY=your_heygen_api_key_here
HEYGEN_DEFAULT_AVATAR_ID=xxx
HEYGEN_DEFAULT_AVATAR_NAME=xxx
HEYGEN_DEFAULT_VOICE_ID=xxx
HEYGEN_DEFAULT_VOICE_NAME=xxx
HEYGEN_WEBHOOK_SECRET=xxx

# PIAPI
PIAPI_API_KEY=key_piapi

# Kling AI — Motion Control video generation
KLING_API_KEY=your_kling_api_key_here
# Mặc định dùng API toàn cầu; đổi thành https://api-singapore.klingai.com nếu cần region SG
KLING_API_BASE_URL=https://api.klingai.com

# Redis internal Docker network
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Multilayer DDoS protection overrides
DDOS_GLOBAL_WINDOW_MS=900000
DDOS_GLOBAL_LIMIT=1000
DDOS_PUBLIC_WINDOW_MS=900000
DDOS_PUBLIC_LIMIT=150
DDOS_EXPENSIVE_WINDOW_MS=900000
DDOS_EXPENSIVE_LIMIT=60
DDOS_GENERAL_BODY_LIMIT=2mb
DDOS_LARGE_BODY_LIMIT=300mb
DDOS_SOCKET_HANDSHAKE_WINDOW_MS=60000
DDOS_SOCKET_HANDSHAKE_LIMIT=20
DDOS_SOCKET_MAX_PER_USER=10
DDOS_SOCKET_MAX_PER_IP=30
DDOS_SOCKET_EVENT_WINDOW_MS=60000
DDOS_SOCKET_EVENT_LIMIT=120
DDOS_SOCKET_VIOLATION_LIMIT=3
DDOS_REDIS_PREFIX=igen:ddos:

# Exactly 32 random bytes encoded as 64 hex characters.
SUPERADMIN_ENCRYPTION_KEY=
# Deployment-owned; accepted values are staging or production.
DEPLOYMENT_ENV=staging
