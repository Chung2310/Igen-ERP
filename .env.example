# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=key

# GEMINI_MODEL: Text model used by server-side Gemini calls.
GEMINI_MODEL="gemini-2.5-flash"

# GEMINI_IMAGE_MODEL: Image generation model.
GEMINI_IMAGE_MODEL="imagen-4.0-generate-001"

# GEMINI_VIDEO_MODEL: Video generation model.
GEMINI_VIDEO_MODEL="veo-3.1-generate-preview"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Super Admin Account Seed configuration credentials
VITE_SUPERADMIN_EMAIL=superadmin@igen.com
VITE_SUPERADMIN_PASSWORD=superadmin123
VITE_SUPERADMIN_NAME="Super Admin"