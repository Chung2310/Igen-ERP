# AI Marketing — nội dung chữ và ảnh trong Campaign gọi qua OpenRouter
# Tên model google/gemini-* là model trên OpenRouter, không dùng key Google riêng.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL="google/gemini-2.5-flash"
OPENROUTER_HEAVY_MODEL="google/gemini-3.5-flash"
OPENROUTER_IMAGE_MODEL="google/gemini-3.1-flash-image"
# Fallback cho text; không áp dụng model text cho tạo ảnh.
OPENROUTER_FALLBACK_MODEL="qwen/qwen3.6-flash"

# URL HTTPS công khai của ERP, dùng cho approval link và callback/OAuth.
APP_URL=

# SePay retail-order webhook authentication. Prefer HMAC-SHA256 in production.
# Configure SePay webhook URL: POST /api/v1/webhook/sepay/retail-payment
SEPAY_WEBHOOK_SECRET=
# Optional API Key fallback for legacy SePay webhook configurations.
SEPAY_API_KEY=

# Super Admin Account Seed configuration credentials (chỉ dùng phía server)
# Nếu để trống SUPERADMIN_PASSWORD, server sẽ bỏ qua bước seed tài khoản superadmin.
# LƯU Ý: không dùng tiền tố VITE_ cho các biến nhạy cảm — Vite sẽ đưa biến VITE_* vào bundle frontend.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=

# Cloudinary Integration Config
CLOUDINARY_CLOUD_NAME=xx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# MongoDB Integration Config
MONGODB_URI=xxx
MONGODB_USER=xxx
MONGODB_PASSWORD=xxx
MONGODB_AUTH_SOURCE=xxx

# JWT Auth Config (BẮT BUỘC — server từ chối khởi động nếu để trống)
# Sinh secret ngẫu nhiên: openssl rand -hex 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Student QR remembered-device credentials. Generate a separate random value:
# openssl rand -hex 64
STUDENT_DEVICE_TOKEN_PEPPER=
# Device recognition is renewed after each successful use; valid range is 1-365 days.
STUDENT_DEVICE_TTL_DAYS=180

# Worker QR remembered-device credentials. Generate a separate random value:
# openssl rand -hex 64
WORKER_DEVICE_TOKEN_PEPPER=
# Device recognition is renewed after each successful use; valid range is 1-365 days.
WORKER_DEVICE_TTL_DAYS=180

# Redis internal Docker network
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Multilayer DDoS protection overrides
DDOS_GLOBAL_WINDOW_MS=900000
DDOS_GLOBAL_LIMIT=1000
DDOS_PUBLIC_WINDOW_MS=900000
DDOS_PUBLIC_LIMIT=150
DDOS_EXPENSIVE_WINDOW_MS=900000
DDOS_EXPENSIVE_LIMIT=60
# Wide IP backstops for shared office NAT/CGNAT; per-account and per-user limits remain stricter.
DDOS_AUTH_IP_LIMIT=300
DDOS_LOGIN_ACCOUNT_WINDOW_MS=900000
DDOS_LOGIN_ACCOUNT_LIMIT=10
DDOS_REFRESH_IP_WINDOW_MS=900000
DDOS_REFRESH_IP_LIMIT=1000
DDOS_GENERAL_BODY_LIMIT=2mb
DDOS_LARGE_BODY_LIMIT=300mb
DDOS_SOCKET_HANDSHAKE_WINDOW_MS=60000
DDOS_SOCKET_HANDSHAKE_LIMIT=300
DDOS_SOCKET_MAX_PER_USER=5
DDOS_SOCKET_MAX_PER_IP=500
DDOS_SOCKET_EVENT_WINDOW_MS=60000
DDOS_SOCKET_EVENT_LIMIT=120
DDOS_SOCKET_VIOLATION_LIMIT=3
DDOS_REDIS_PREFIX=igen:ddos:

# Exactly 32 random bytes encoded as 64 hex characters.
SUPERADMIN_ENCRYPTION_KEY=
# Deployment-owned; accepted values are staging or production.
DEPLOYMENT_ENV=staging

# Server-only InsightFace integration (never expose through VITE_* variables)
INSIGHTFACE_URL=http://insightface:8000
INSIGHTFACE_API_KEY=replace-with-server-api-key
INSIGHTFACE_TIMEOUT_MS=10000

# Marketing suite: enable social-marketing / omni-inbox / company-knowledge in company modules.
# Use a separate Redis prefix and separate provider accounts from the standalone Marketing app.
MARKETING_WORKERS_ENABLED=false
MARKETING_WORKER_ROLE=all
MARKETING_QUEUE_PREFIX=igen-erp-marketing-staging
MARKETING_TELEGRAM_POLLING_ENABLED=false
MARKETING_APPROVAL_SECRET=
CAMPAIGN_WORKER_SECRET=
N8N_WEBHOOK_SECRET=
MARKETING_BAKERY_COMPANY_CODES=
# APP_URL must be the public ERP HTTPS origin; do not use the standalone Marketing origin.
FB_APP_ID=
FB_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_WEBHOOK_SECRET=
ZALO_APP_ID=
ZALO_OA_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CONFIG_ENCRYPTION_KEY=
SEPAY_CONFIG_ENCRYPTION_KEY=
N8N_FB_WEBHOOK_URL=
N8N_CAMPAIGN_FB_WEBHOOK_URL=
# Optional fallback key for Campaign voice audio.
# Leave blank when credentials are configured per user/company.
ELEVENLABS_API_KEY=
# Local media rendering requires FFmpeg and Chromium. Docker supplies both.
FFMPEG_PATH=
CHROME_PATH=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=
CANVA_TOKEN_ENCRYPTION_KEY=
