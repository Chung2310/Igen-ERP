# Sao chép thành .env và điền cấu hình riêng cho môi trường chạy.
# Không commit .env. Không dùng tiền tố VITE_ cho khóa bí mật phía server.

# === Ứng dụng ===
NODE_ENV=development
# Chỉ nhận staging hoặc production; khác với chế độ chạy Node ở trên.
DEPLOYMENT_ENV=staging
PORT=3000
APP_URL=http://localhost:3000
TZ=Asia/Ho_Chi_Minh
# Origin được phép, phân cách bằng dấu phẩy; để trống dùng mặc định của server.
LINK_COR=

# === Bảo mật — bắt buộc trước khi khởi động ===
# JWT: sinh riêng mỗi secret bằng openssl rand -hex 64.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Khóa mã hóa: đúng 64 ký tự hex (openssl rand -hex 32).
SUPERADMIN_ENCRYPTION_KEY=

# === MongoDB ===
# Trong Docker, dùng hostname MongoDB trên cùng network.
MONGODB_URI=mongodb://localhost:27017/lux-care
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin
# Nghiệp vụ giao dịch cần replica set; chỉ bật ngoại lệ khi phát triển local.
# ALLOW_STANDALONE_MONGODB=false
# PAYROLL_ALLOW_NON_ATOMIC_DEVELOPMENT=false

# === Redis ===
# Đặt false khi local không có Redis. Trong Docker, dùng tên service Redis.
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# === Tài khoản quản trị khởi tạo — chỉ dùng phía server ===
# Để trống mật khẩu để bỏ qua bước seed superadmin.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=
# SEED_MOCK_USERS=false

# === Ví và nạp tiền — PayOS ===
# Chọn sepay để dùng QR chuyển khoản và webhook; trống hoặc payos dùng luồng cũ.
WALLET_PAYMENT_PROVIDER=
# Cần đủ cả ba giá trị để nhận thanh toán thật.
# Webhook: <APP_URL>/api/v1/wallet/webhook
# Thiếu cấu hình: local dùng giả lập; NODE_ENV=production từ chối tạo thanh toán.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# === Ví và nạp tiền — SePay ===
# Webhook POST: <APP_URL>/api/v1/wallet/webhook/sepay
# Trên SePay chọn Có tiền vào, xác thực API Key; dùng cùng khóa bên dưới.
# SEPAY_BANK_CODE: short_name trùng gateway trong webhook, ví dụ Vietcombank.
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# Tùy chọn: số VA để tạo QR khác số tài khoản gốc; mặc định dùng ACCOUNT_NUMBER.
SEPAY_QR_ACCOUNT_NUMBER=
# Nếu dùng VA, điền giá trị subAccount SePay gửi để đối soát đúng VA.
SEPAY_SUB_ACCOUNT=
# Chuỗi thêm trước mã LCxxxxxxxx; VietinBank cá nhân/HKD cần SEVQR.
# VA theo nội dung chuyển khoản có thể cần TKP<ma-VA>.
SEPAY_TRANSFER_NOTE=
# Cấu hình tiền tố mã thanh toán LC trên SePay; MongoDB cần replica set
# để cập nhật ví và giao dịch nguyên tử, chống cộng tiền lặp khi retry webhook.

# === AI — OpenRouter ===
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODEL=qwen/qwen3.6-flash
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
OPENROUTER_FALLBACK_IMAGE_MODEL=google/gemini-3-pro-image
# Tùy chọn: endpoint tương thích OpenAI cho tầng fallback cuối.
FREELLM_API_URL=
FREELLM_API_KEY=
FREELLM_API_MODEL=auto

# === Trợ lý AI và kho tri thức ===
ASSISTANT_GROUNDED_ENABLED=true
CHATBOT_MODEL=google/gemini-2.5-flash
# hybrid cần embedding model; để trống mode dùng tìm kiếm từ khóa.
KNOWLEDGE_RETRIEVAL_MODE=
KNOWLEDGE_EMBEDDING_MODEL=
# Chỉ điền khi đã tạo vector index trong MongoDB.
KNOWLEDGE_VECTOR_INDEX=
KNOWLEDGE_RERANK_ENABLED=false
# Để trống các model dưới để dùng model mặc định trong mã nguồn.
KNOWLEDGE_RERANK_MODEL=
KNOWLEDGE_QUERY_EXPANSION_ENABLED=true
KNOWLEDGE_QUERY_MODEL=
KNOWLEDGE_PDF_OCR_MODEL=
KNOWLEDGE_WORKER_ENABLED=true
KNOWLEDGE_LEGAL_REVIEW_WORKER_ENABLED=true
# === Lưu trữ tệp — Cloudinary ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# === Google OAuth — tích hợp Drive ===
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# === Nhận diện khuôn mặt — InsightFace ===
# Cần URL và API key khi dùng tính năng nhận diện.
INSIGHTFACE_URL=
INSIGHTFACE_API_KEY=
INSIGHTFACE_TIMEOUT_MS=10000

# === Thông báo đẩy — Web, Firebase và Expo ===
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Đường dẫn file service account phía server, không đưa vào frontend/APK.
# Có thể dùng Application Default Credentials khi chạy trên Google hosting.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
EXPO_ACCESS_TOKEN=
# CI lấy GitHub secret GOOGLE_SERVICE_JSON, mount file vào runtime-secrets
# và tự đặt GOOGLE_APPLICATION_CREDENTIALS; không dán JSON vào file này.

# === Liên kết Telegram ===
TELEGRAM_BOT_USERNAME=iGEN_ERP_Bot

# === Giới hạn yêu cầu và chống DDoS ===
# Thời gian tính bằng mili giây; các giá trị dưới khớp mặc định trong mã nguồn.
DDOS_GLOBAL_WINDOW_MS=900000
DDOS_GLOBAL_LIMIT=1000
DDOS_PUBLIC_WINDOW_MS=900000
DDOS_PUBLIC_LIMIT=150
DDOS_EXPENSIVE_WINDOW_MS=900000
DDOS_EXPENSIVE_LIMIT=60
# Giới hạn IP đủ rộng cho văn phòng chung NAT; đăng nhập còn giới hạn theo tài khoản.
DDOS_AUTH_IP_WINDOW_MS=900000
DDOS_AUTH_IP_LIMIT=300
DDOS_LOGIN_ACCOUNT_WINDOW_MS=900000
DDOS_LOGIN_ACCOUNT_LIMIT=10
DDOS_REFRESH_IP_WINDOW_MS=900000
DDOS_REFRESH_IP_LIMIT=1000
DDOS_GENERAL_BODY_LIMIT=2mb
DDOS_LARGE_BODY_LIMIT=300mb
DDOS_SOCKET_HANDSHAKE_WINDOW_MS=60000
DDOS_SOCKET_HANDSHAKE_LIMIT=300
DDOS_SOCKET_MAX_PER_USER=5
DDOS_SOCKET_MAX_PER_IP=500
DDOS_SOCKET_EVENT_WINDOW_MS=60000
DDOS_SOCKET_EVENT_LIMIT=120
DDOS_SOCKET_VIOLATION_LIMIT=3
DDOS_REDIS_PREFIX=igen:ddos:

# AI billing: USD to VND accounting rate; empty uses 25400. 100 VND = 1 Credit.
AI_USD_TO_VND=

# === Public account and company onboarding ===
# Enable after platform SMTP and transaction-capable MongoDB are configured.
PUBLIC_REGISTRATION_ENABLED=true
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_SECURE=false
PLATFORM_SMTP_USER=
PLATFORM_SMTP_PASSWORD=
PLATFORM_SMTP_FROM=
PLATFORM_PUBLIC_URL=
# Explicit provisioning CLI URI only; never used by the running application.
# ONBOARDING_PROVISION_MONGODB_URI=

# === AI miễn phí dùng chung hạn mức trên web/mobile ===
# Có thể giữ cấu hình hiện tại; AI_FREE_ENABLED ưu tiên hơn cờ AI_PERSONAL_FREE_ENABLED cũ.
AI_FREE_ENABLED=false
# Luồng Credit/nạp tiền được tạm khóa bằng shared/features.ts; giữ cấu hình ví bên dưới để dùng lại sau.
# Bật riêng sau khi kiểm tra replica set, OpenRouter, SMTP và ngân sách thực tế.
AI_PERSONAL_FREE_ENABLED=false
AI_PERSONAL_HOURLY_LIMIT=10
AI_PERSONAL_DAILY_LIMIT=30
AI_PERSONAL_MONTHLY_LIMIT=900
# Ngân sách vận hành USD do LuxCare chịu, theo tháng giờ Việt Nam; bắt buộc > 0 khi bật AI.
AI_PERSONAL_MONTHLY_BUDGET_USD=
AI_PERSONAL_REQUEST_RESERVE_USD=0.05
AI_COMPANY_WALLET_ENABLED=false

# Logging: JSON in production; pretty text in development unless overridden.
# LOG_LEVEL=info
# LOG_FORMAT=json
# LOG_SLOW_REQUEST_MS=1000
# APP_VERSION=<git-sha-or-release>
# INSTANCE_ID=<instance-name>
