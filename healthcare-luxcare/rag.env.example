# Copy selected values into the environment used by both web and worker.
# Secrets belong in deployment secret storage, never in this file.
KNOWLEDGE_RETRIEVAL_MODE=hybrid
KNOWLEDGE_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
KNOWLEDGE_RERANK_ENABLED=true
KNOWLEDGE_RERANK_MODEL=google/gemini-2.5-flash
# Query expansion adds up to three search variants and falls back to the original on failure.
KNOWLEDGE_QUERY_EXPANSION_ENABLED=true
KNOWLEDGE_QUERY_MODEL=google/gemini-2.5-flash
KNOWLEDGE_VECTOR_INDEX=
KNOWLEDGE_WORKER_ENABLED=true
# Scanned PDFs use the existing OPENROUTER_API_KEY.
# The OpenRouter OCR model must support native PDF input and PNG images (long scans).
KNOWLEDGE_PDF_OCR_MODEL=google/gemini-2.5-flash
# Existing documents require reindexing to gain real embeddings.
