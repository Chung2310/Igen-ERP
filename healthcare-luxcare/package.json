{
  "name": "lux-care",
  "private": true,
  "version": "0.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-server/server.cjs",
    "start": "node dist-server/server.cjs",
    "clean": "rm -rf dist dist-server server.js",
    "typecheck": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "audit:toast-errors": "tsx tools/frontend-toast-error-audit.ts",
    "lint": "eslint src/App.tsx src/components/hr/KanbanTab.tsx src/pages/DashboardTab.tsx src/pages/Header.tsx src/pages/Sidebar.tsx",
    "format": "prettier --write .",
    "reset:superadmin-totp": "tsx server/scripts/reset-superadmin-totp.ts",
    "backfill:batch-enrollments": "tsx server/scripts/backfill-batch-enrollments.ts",
    "debug:fb-autoreply": "tsx scripts/fb-autoreply-debug.ts",
    "fix:fb-conversation-index": "tsx scripts/fix_fb_conversation_index.ts",
    "stress:staging": "tsx tools/controlled-staging-stress-test.ts",
    "load:production": "tsx tools/production-stepped-load-test.ts",
    "load:setup": "tsx tools/comprehensive-load/setup-command.ts",
    "load:run": "tsx tools/comprehensive-load/run-command.ts",
    "load:cleanup": "tsx tools/comprehensive-load/cleanup-command.ts",
    "inspect:supplies": "tsx server/scripts/inspect-supplies.ts",
    "migrate:supply-inventory": "tsx server/scripts/migrate-supply-inventory.ts",
    "test:supplies": "vitest run shared/supply-stock.test.ts server/service/supply server/service/supply.service.test.ts server/middleware/supply-scope.test.ts server/validation/supply.validation.test.ts server/validation/supply-batch.validation.test.ts server/validation/warehouse.validation.test.ts src/components/supply/SupplyBatchStockModal.test.tsx src/components/supply/SupplyInventoryWorkspace.test.tsx",
    "provision:supply-inventory": "tsx server/scripts/provision-supply-inventory.ts",
    "rag:eval": "tsx tools/rag-evaluation/run.ts",
    "rag:eval:local": "tsx tools/rag-evaluation/local-files.ts",
    "rag:worker": "tsx tools/knowledge-worker.ts",
    "rag:reindex": "tsx tools/reindex-knowledge.ts",
    "rag:vector-index": "tsx tools/setup-knowledge-vector-index.ts",
    "provision:onboarding": "tsx server/scripts/provision-onboarding.ts",
    "test:onboarding": "vitest run shared/onboarding.test.ts server/middleware/auth.onboarding.test.ts server/middleware/auth.single-session.test.ts server/service/onboarding.service.test.ts server/service/auth-delete-own-account.test.ts --maxWorkers 1"
  },
